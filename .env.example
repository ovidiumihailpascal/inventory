# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=inventory
DB_USER=inventory_app
DB_PASSWORD=change-me-to-a-secure-password-in-production

# Flask Configuration
FLASK_ENV=production
FLASK_SECRET=change-me-to-a-secure-random-secret-in-production

# Admin Credentials (change these!)
INVENTORY_USER=admin
INVENTORY_PASS=change-default-password-in-production

# Application Port
APP_PORT=5000

# PostgreSQL Admin (optional - for initial setup)
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=change-me-postgres-admin-password
